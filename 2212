' Reading source values
' ---------------------------------------------------------------------------

' Reads one source cell and says why it could not be used, so a cell holding
' "N/A" or a label can be named in the message rather than disappearing.
' Takes the cell rather than its value so the displayed text is available.
Private Function LDR_ReadCell(ByVal sourceCell As Range) As LDR_Reading
    Dim reading As LDR_Reading
    Dim rawValue As Variant
    Dim textValue As String
    Dim negativeValue As Boolean

    rawValue = sourceCell.Value2

    If IsError(rawValue) Then
        reading.Status = LDR_READ_ERROR
        reading.DisplayText = LDR_CellText(sourceCell)
        LDR_ReadCell = reading
        Exit Function
    End If

    If IsEmpty(rawValue) Or IsNull(rawValue) Then
        reading.Status = LDR_READ_BLANK
        LDR_ReadCell = reading
        Exit Function
    End If

    ' Numeric text goes through the text branch below, which also handles
    ' thousands separators and (1.23) for negatives.
    If IsNumeric(rawValue) And VarType(rawValue) <> vbString Then
        reading.Value = CDbl(rawValue)
    Else
        textValue = CStr(rawValue)

        ' Reports exported from other systems use a non-breaking space as a
        ' thousands separator and a Unicode minus or dash for negatives.
        textValue = Replace(textValue, ChrW(160), "")
        textValue = Replace(textValue, ChrW(8722), "-")
        textValue = Replace(textValue, ChrW(8211), "-")
        textValue = Replace(textValue, ChrW(8212), "-")
        textValue = Trim$(textValue)

        If Len(textValue) = 0 Or textValue = "-" Then
            reading.Status = LDR_READ_BLANK
            LDR_ReadCell = reading
            Exit Function
        End If

        reading.DisplayText = LDR_ShortText(textValue)

        textValue = Replace(textValue, ",", "")
        textValue = Replace(textValue, "$", "")
        textValue = Replace(textValue, " ", "")

        If Left$(textValue, 1) = "(" And Right$(textValue, 1) = ")" Then
            negativeValue = True
            textValue = Mid$(textValue, 2, Len(textValue) - 2)
        ElseIf Right$(textValue, 1) = "-" Then
            ' Trailing minus, as some report writers emit for negatives.
            negativeValue = True
            textValue = Left$(textValue, Len(textValue) - 1)
        End If

        If Not IsNumeric(textValue) Then
            reading.Status = LDR_READ_TEXT
            LDR_ReadCell = reading
            Exit Function
        End If

        reading.Value = CDbl(textValue)
        If negativeValue Then reading.Value = -reading.Value
        reading.DisplayText = vbNullString
    End If

    reading.Value = Application.WorksheetFunction.Round(reading.Value, 2)
    reading.Status = LDR_READ_OK
    LDR_ReadCell = reading
End Function

' Range.Text is what the user sees, including "#N/A". It falls back to the
' stored value when the column is too narrow and Excel returns "###".
Private Function LDR_CellText(ByVal sourceCell As Range) As String
    Dim resultText As String

    On Error Resume Next
    resultText = CStr(sourceCell.Text)
    On Error GoTo 0

    If Len(Replace(resultText, "#", "")) = 0 And Len(resultText) > 1 Then
        resultText = vbNullString
    End If

    If Len(resultText) = 0 Then resultText = "an error value"

    LDR_CellText = LDR_ShortText(resultText)
End Function

Private Function LDR_ShortText(ByVal textValue As String) As String
    If Len(textValue) > LDR_MAX_CELL_TEXT Then
        LDR_ShortText = Left$(textValue, LDR_MAX_CELL_TEXT) & "..."
    Else
        LDR_ShortText = textValue
    End If
End Function

