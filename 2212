Private Function LDR_ConfirmWrite(ByRef ctx As LDR_Context, _
                                  ByVal loaderWb As Workbook, _
                                  ByVal loaderNote As String, _
                                  ByVal runDate As Date, _
                                  ByVal modeText As String, _
                                  ByVal dateNotes As String) As Boolean
    Dim messageText As String

    ' Nothing matched, so there is nothing to write and nothing to confirm.
    If ctx.TargetCells.Count = 0 Then Exit Function

    If Not LDR_CONFIRM_BEFORE_WRITE Then
        LDR_ConfirmWrite = True
        Exit Function
    End If

    messageText = "About to write " & CStr(ctx.TargetCells.Count) & _
                  " values to the AMOUNT column." & vbCrLf & vbCrLf & _
                  LDR_RunHeader(loaderWb, ctx, runDate, modeText) & _
                  "Loader picked: " & loaderNote & vbCrLf & _
                  LDR_WarningBlock(ctx) & LDR_DateBlock(dateNotes) & _
                  vbCrLf & "Continue?"

    LDR_ConfirmWrite = (MsgBox(messageText, vbOKCancel + vbQuestion, _
                               "PB Loader") = vbOK)
End Function

Private Function LDR_RunHeader(ByVal loaderWb As Workbook, _
                               ByRef ctx As LDR_Context, _
                               ByVal runDate As Date, _
                               ByVal modeText As String) As String

    LDR_RunHeader = "Loader: " & loaderWb.Name & " / " & _
                    ctx.LoaderWs.Name & vbCrLf & _
                    "Run date: " & Format$(runDate, "yyyy-mm-dd") & " " & _
                    Format$(runDate, "dddd") & vbCrLf & _
                    "Mode: " & modeText & vbCrLf
End Function

Private Function LDR_WarningBlock(ByRef ctx As LDR_Context) As String
    If ctx.WarningCount = 0 Then Exit Function

    LDR_WarningBlock = vbCrLf & "Not loaded (" & CStr(ctx.WarningCount) & "):" & _
                       vbCrLf & LDR_CapText(ctx.Warnings, LDR_MAX_MESSAGE_LINES)
End Function

Private Function LDR_DateBlock(ByVal dateNotes As String) As String
    If Len(dateNotes) = 0 Then Exit Function

    LDR_DateBlock = vbCrLf & "Source report dates to check:" & vbCrLf & _
                    LDR_CapText(dateNotes, LDR_MAX_MESSAGE_LINES)
End Function

' A message box cannot hold the whole run, so the detail goes to the
' Immediate window where it can be read after the fact.
Private Sub LDR_LogRun(ByRef ctx As LDR_Context, _
                       ByVal loaderWb As Workbook, _
                       ByVal runDate As Date, _
                       ByVal modeText As String, _
                       ByVal dateNotes As String)
    Dim i As Long

    Debug.Print String$(60, "-")
    Debug.Print "PB Loader run " & Format$(Now, "yyyy-mm-dd hh:nn:ss")
    Debug.Print "Loader: " & loaderWb.Name & " / " & ctx.LoaderWs.Name
    Debug.Print "Run date: " & Format$(runDate, "yyyy-mm-dd") & _
                "  Mode: " & modeText

    Debug.Print "Queued (" & CStr(ctx.TargetCells.Count) & "):"
    For i = 1 To ctx.TargetCells.Count
        Debug.Print "  " & ctx.TargetCells(i).Address(False, False) & " = " & _
                    Format$(ctx.TargetValues(i), "0.00") & "  <- " & _
                    CStr(ctx.TargetDetails(i))
    Next i

    If Len(ctx.Problems) > 0 Then
        Debug.Print "Problems (run will stop):"
        Debug.Print ctx.Problems
    End If

    If Len(ctx.Warnings) > 0 Then
        Debug.Print "Not loaded:"
        Debug.Print ctx.Warnings
    End If

    If Len(dateNotes) > 0 Then
        Debug.Print "Source report dates to check:"
        Debug.Print dateNotes
    End If
End Sub

Private Function LDR_CapText(ByVal textValue As String, _
                             ByVal maxLines As Long) As String
    Dim lines As Variant
    Dim lineIndex As Long
    Dim shownCount As Long
    Dim hiddenCount As Long
    Dim resultText As String

    If Len(textValue) = 0 Then Exit Function

    lines = Split(textValue, vbCrLf)

    For lineIndex = LBound(lines) To UBound(lines)
        If Len(Trim$(CStr(lines(lineIndex)))) > 0 Then
            If shownCount < maxLines Then
                resultText = resultText & CStr(lines(lineIndex)) & vbCrLf
                shownCount = shownCount + 1
            Else
                hiddenCount = hiddenCount + 1
            End If
        End If
    Next lineIndex

    If hiddenCount > 0 Then
        resultText = resultText & "  ... and " & CStr(hiddenCount) & _
                     " more (see the Immediate window)." & vbCrLf
    End If

    LDR_CapText = resultText
End Function

