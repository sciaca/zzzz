Private Function LDR_ColumnValues(ByVal ws As Worksheet, _
                                  ByVal columnNumber As Long, _
                                  ByVal firstRow As Long, _
                                  ByVal lastRow As Long) As Variant
    Dim rawValues As Variant
    Dim resultValues() As Variant
    Dim rowCount As Long
    Dim i As Long

    rowCount = lastRow - firstRow + 1
    ReDim resultValues(1 To rowCount)

    If rowCount = 1 Then
        ' A single cell returns a scalar rather than an array.
        resultValues(1) = ws.Cells(firstRow, columnNumber).Value2
    Else
        rawValues = ws.Range(ws.Cells(firstRow, columnNumber), _
                             ws.Cells(lastRow, columnNumber)).Value2

        For i = 1 To rowCount
            resultValues(i) = rawValues(i, 1)
        Next i
    End If

    LDR_ColumnValues = resultValues
End Function

Private Function LDR_FindHeaderRow(ByVal ws As Worksheet) As Long
    Dim rowNumber As Long

    For rowNumber = 1 To 20
        If LDR_FindHeaderColumn(ws, rowNumber, "entityid") > 0 _
           And LDR_FindHeaderColumn(ws, rowNumber, "amount") > 0 _
           And LDR_FindHeaderColumn(ws, rowNumber, "currency") > 0 _
           And LDR_FindHeaderColumn(ws, rowNumber, "annotation") > 0 Then

            LDR_FindHeaderRow = rowNumber
            Exit Function
        End If
    Next rowNumber
End Function

' Exact header first. A partial match would otherwise take "BASE AMOUNT" or
' "AMOUNT CCY" simply because it sits further left than the real column.
Private Function LDR_FindHeaderColumn(ByVal ws As Worksheet, _
                                      ByVal headerRow As Long, _
                                      ByVal searchToken As String) As Long
    Dim lastColumn As Long
    Dim columnNumber As Long
    Dim headerTexts() As String
    Dim normalizedText As String

    lastColumn = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    ReDim headerTexts(1 To lastColumn)

    For columnNumber = 1 To lastColumn
        normalizedText = LDR_NormalizeText( _
            LDR_SafeText(ws.Cells(headerRow, columnNumber).Value2))

        headerTexts(columnNumber) = normalizedText

        If normalizedText = searchToken Then
            LDR_FindHeaderColumn = columnNumber
            Exit Function
        End If
    Next columnNumber

    For columnNumber = 1 To lastColumn
        If Len(headerTexts(columnNumber)) > 0 Then
            If InStr(1, headerTexts(columnNumber), searchToken, _
                     vbTextCompare) > 0 Then

                LDR_FindHeaderColumn = columnNumber
                Exit Function
            End If
        End If
    Next columnNumber
End Function

' Uses UsedRange rather than Range.Find so the user's next manual Find is not
' left with this macro's search options.
Private Function LDR_LastUsedRow(ByVal ws As Worksheet) As Long
    Dim usedRows As Long

    usedRows = ws.UsedRange.Rows.Count
    LDR_LastUsedRow = ws.UsedRange.Row + usedRows - 1

    If LDR_LastUsedRow < 1 Then LDR_LastUsedRow = 1
End Function

Private Function LDR_RequireWorksheet(ByVal wb As Workbook, _
                                      ByVal sheetName As String, _
                                      ByVal errorNumber As Long) As Worksheet

    Set LDR_RequireWorksheet = LDR_GetWorksheetFlexible(wb, sheetName)

    If LDR_RequireWorksheet Is Nothing Then
        Err.Raise vbObjectError + errorNumber, _
                  "Load_PB_Differences_ValuesOnly", _
                  "Source tab not found: " & sheetName
    End If
End Function

Private Function LDR_FindOrOpenSourceWorkbook() As Workbook
    Dim wb As Workbook
    Dim candidateWs As Worksheet
    Dim selectedPath As String

    ' Prefer the workbook containing this macro. This prevents an older,
    ' still-open PB Summary workbook from being selected by accident.
    Set candidateWs = LDR_GetWorksheetFlexible(ThisWorkbook, LDR_SOURCE_SHEET)

    If Not candidateWs Is Nothing Then
        Set LDR_FindOrOpenSourceWorkbook = ThisWorkbook
        Exit Function
    End If

    ' Second preference: the workbook the user is currently viewing.
    If Not ActiveWorkbook Is Nothing Then
        Set candidateWs = LDR_GetWorksheetFlexible( _
            ActiveWorkbook, LDR_SOURCE_SHEET)

        If Not candidateWs Is Nothing Then
            Set LDR_FindOrOpenSourceWorkbook = ActiveWorkbook
            Exit Function
        End If
    End If

    For Each wb In Application.Workbooks
        Set candidateWs = LDR_GetWorksheetFlexible(wb, LDR_SOURCE_SHEET)

        If Not candidateWs Is Nothing Then
            Set LDR_FindOrOpenSourceWorkbook = wb
            Exit Function
        End If
    Next wb

    selectedPath = LDR_PickWorkbook("Select the PB_Summary_NEW workbook")

    If Len(selectedPath) = 0 Then Exit Function

    Set LDR_FindOrOpenSourceWorkbook = Workbooks.Open( _
        Filename:=selectedPath, _
        UpdateLinks:=0, _
        ReadOnly:=True, _
        AddToMru:=False)
End Function

' loaderNote records how the workbook was chosen, because the second and third
' preferences can land on a workbook the user did not have in mind. It is shown
' in the confirmation message.
Private Function LDR_FindOrOpenLoaderWorkbook( _
    ByVal sourceWb As Workbook, _
    ByRef loaderNote As String) As Workbook

    Dim wb As Workbook
    Dim candidateWs As Worksheet
    Dim selectedPath As String

    ' First preference: an open workbook whose name contains "PB loader".
    For Each wb In Application.Workbooks
        If Not wb Is sourceWb Then
            If InStr(1, wb.Name, "PB loader", vbTextCompare) > 0 Then
                Set candidateWs = LDR_GetWorksheetFlexible( _
                    wb, LDR_TARGET_SHEET)

                If Not candidateWs Is Nothing Then
                    loaderNote = "open workbook named ""PB loader"""
                    Set LDR_FindOrOpenLoaderWorkbook = wb
                    Exit Function
                End If
            End If
        End If
    Next wb

    ' Second preference: any other open workbook containing TEMPLATE.
    For Each wb In Application.Workbooks
        If Not wb Is sourceWb Then
            Set candidateWs = LDR_GetWorksheetFlexible(wb, LDR_TARGET_SHEET)

            If Not candidateWs Is Nothing Then
                loaderNote = "open workbook with a " & LDR_TARGET_SHEET & _
                             " tab (name does not contain ""PB loader"")"
                Set LDR_FindOrOpenLoaderWorkbook = wb
                Exit Function
            End If
        End If
    Next wb

    selectedPath = LDR_PickWorkbook("Select the PB loader template workbook")

    If Len(selectedPath) = 0 Then Exit Function

    loaderNote = "chosen by you in the file dialog"

    Set LDR_FindOrOpenLoaderWorkbook = Workbooks.Open( _
        Filename:=selectedPath, _
        UpdateLinks:=0, _
        ReadOnly:=False, _
        AddToMru:=False)
End Function

Private Function LDR_PickWorkbook(ByVal dialogTitle As String) As String
    With Application.FileDialog(3)
        .Title = dialogTitle
        .AllowMultiSelect = False
        .Filters.Clear
        .Filters.Add "Excel workbooks", "*.xlsx;*.xls;*.xlsm;*.xlsb"

        If .Show = -1 Then LDR_PickWorkbook = .SelectedItems(1)
    End With
End Function

Private Function LDR_GetWorksheetFlexible(ByVal wb As Workbook, _
                                          ByVal expectedName As String) _
                                          As Worksheet
    Dim ws As Worksheet
    Dim normalizedExpected As String

    If wb Is Nothing Then Exit Function

    On Error Resume Next
    Set LDR_GetWorksheetFlexible = wb.Worksheets(expectedName)
    On Error GoTo 0

    If Not LDR_GetWorksheetFlexible Is Nothing Then Exit Function

    normalizedExpected = LDR_NormalizeText(expectedName)

    For Each ws In wb.Worksheets
        If LDR_NormalizeText(ws.Name) = normalizedExpected Then
            Set LDR_GetWorksheetFlexible = ws
            Exit Function
        End If
    Next ws
End Function

' CStr on an error value raises a type mismatch, which used to surface as an
' unrelated "Loader stopped" message when a key column held #N/A.
Private Function LDR_SafeText(ByVal rawValue As Variant) As String
    If IsError(rawValue) Then Exit Function
    If IsNull(rawValue) Then Exit Function
    If IsEmpty(rawValue) Then Exit Function

    LDR_SafeText = CStr(rawValue)
End Function

Private Function LDR_NormalizeText(ByVal textValue As String) As String
    Dim resultText As String

    resultText = LCase$(Trim$(textValue))
    resultText = Replace(resultText, ChrW(160), "")
    resultText = Replace(resultText, " ", "")
    resultText = Replace(resultText, "_", "")
    resultText = Replace(resultText, "-", "")
    resultText = Replace(resultText, "(", "")
    resultText = Replace(resultText, ")", "")
    resultText = Replace(resultText, "/", "")

    LDR_NormalizeText = resultText
End Function
