Option Explicit

' Paste this code into a NEW standard VBA module.
' Run: Load_PB_Differences_ValuesOnly
'
' This macro writes VALUES ONLY to the loader AMOUNT column.
' It does not insert/delete rows, copy formats, or change formulas.
'
' Nothing is written until every mapping has been checked. Anything that
' cannot be loaded is reported instead of being skipped silently:
'   - a hard problem (blank currency, formula in the destination, two
'     mappings pointing at the same cell) means the write itself would be
'     wrong, so the run stops before the first cell is written;
'   - a soft problem (no matching loader row, blank source cell, a source
'     cell holding an error or text) affects one mapping only. The rest are
'     loaded and the skipped cells are listed in the run log.
'
' The message box only ever says "Paste Done". The run log - mode, values
' written, skipped cells, anything that failed - goes to the VBA Immediate
' window, so press Ctrl+G there to see what a run actually did.

Private Const LDR_SOURCE_SHEET As String = "Scotia - RT624BSPh160CS"
Private Const LDR_PH632_RT684_SHEET As String = "PH632-RT684"
Private Const LDR_RT624CS_SHEET As String = "SOCGEN_RT624CS"
Private Const LDR_PH160BS_SHEET As String = "PH191S-PH160BS"
Private Const LDR_PH160AS_SHEET As String = "PH160AS"
Private Const LDR_TARGET_SHEET As String = "TEMPLATE"

Private Const LDR_MODE_NORMAL As Long = 0
Private Const LDR_MODE_MONDAY As Long = 1
Private Const LDR_MODE_LONG_WEEKEND As Long = 2

' ---------------------------------------------------------------------------
' Settings. These four are the only lines you should ever need to change.
' ---------------------------------------------------------------------------

' True  = a difference of 0.00 is written, which clears the amount a previous
'         run left in that loader row.
' False = a 0.00 difference leaves the loader cell untouched and is listed in
'         the run log, so a stale amount is at least traceable.
Private Const LDR_WRITE_ZERO_DIFFERENCES As Boolean = True

' National Day for Truth and Reconciliation (Sep 30) and Remembrance Day
' (Nov 11) are federal holidays but are normal business days in Ontario and
' on the TSX. Treating them as holidays makes the following day look like a
' long weekend and reads the wrong source column. Set to True only if your
' process really does skip them.
Private Const LDR_OBSERVE_SEPT30 As Boolean = False
Private Const LDR_OBSERVE_NOV11 As Boolean = False

' Set to True to check the loader workbook, the mode and the row count in a
' confirmation box before anything is written. Off by default: the same
' detail is in the Immediate window after every run.
Private Const LDR_CONFIRM_BEFORE_WRITE As Boolean = False

' A source cell holding an error or text cannot be loaded, but the other
' mappings still can.
' False = load the rest and list the cell in the run log.
' True  = stop the whole run instead.
Private Const LDR_STOP_ON_UNREADABLE_SOURCE As Boolean = False

Private Const LDR_MAX_MESSAGE_LINES As Long = 12
Private Const LDR_MAX_CELL_TEXT As Long = 40

' Outcomes of reading a single source cell.
Private Const LDR_READ_OK As Long = 0
Private Const LDR_READ_BLANK As Long = 1
Private Const LDR_READ_ERROR As Long = 2
Private Const LDR_READ_TEXT As Long = 3

' The result of reading one source cell, kept together so the queue helpers
' can pass the reason a cell could not be used along with the value.
Private Type LDR_Reading
    Status As Long
    Value As Double
    DisplayText As String
End Type

' Everything the loader side of the run needs, so the queue helpers take a
' handful of arguments instead of fourteen.
Private Type LDR_Context
    LoaderWs As Worksheet
    HeaderRow As Long
    FirstDataRow As Long
    LastRow As Long
    EntityColumn As Long
    AmountColumn As Long
    CurrencyColumn As Long
    AnnotationColumn As Long
    EntityValues As Variant
    CurrencyValues As Variant
    AnnotationValues As Variant
    RowIndex As Object
    TargetIndex As Object
    TargetCells As Collection
    TargetValues As Collection
    TargetDetails As Collection
    Problems As String
    Warnings As String
    WarningCount As Long
End Type

Public Sub Load_PB_Differences_ValuesOnly()
    Dim ctx As LDR_Context
    Dim sourceWb As Workbook
    Dim sourceWs As Worksheet
    Dim ph632Rt684Ws As Worksheet
    Dim rt624csWs As Worksheet
    Dim ph160bsWs As Worksheet
    Dim ph160asWs As Worksheet
    Dim loaderWb As Workbook
    Dim loaderNote As String

    Dim runDate As Date
    Dim runMode As Long
    Dim modeText As String
    Dim dateNotes As String

    Dim interestSourceColumn As String
    Dim ph632InterestFirstRow As Long
    Dim rt684InterestFirstRow As Long
    Dim rt624csStockColumn As String
    Dim rt624csStockFirstRow As Long
    Dim rt624csInterestColumn As String
    Dim rt624csInterestFirstRow As Long
    Dim rt624csCurrencies As Variant
    Dim mappingIndex As Long
    Dim ph160bsCadAddress As String
    Dim ph160bsUsdAddress As String
    Dim ph160asUsdInterestAddress As String
    Dim ph160asCadInterestAddress As String

    Dim i As Long
    Dim writtenCount As Long
    Dim targetCell As Range
    Dim oldScreenUpdating As Boolean
    Dim oldEnableEvents As Boolean
    Dim oldCalculation As XlCalculation
    Dim settingsChanged As Boolean
    Dim errorText As String

    On Error GoTo LDR_Failed

    ' Every exit goes through LDR_CleanUp, so the application settings are
    ' always restored and only one message is ever shown.
    Set sourceWb = LDR_FindOrOpenSourceWorkbook()

    If sourceWb Is Nothing Then GoTo LDR_CleanUp

    Set sourceWs = LDR_RequireWorksheet(sourceWb, LDR_SOURCE_SHEET, 7100)
    Set ph632Rt684Ws = LDR_RequireWorksheet(sourceWb, LDR_PH632_RT684_SHEET, 7106)
    Set rt624csWs = LDR_RequireWorksheet(sourceWb, LDR_RT624CS_SHEET, 7107)
    Set ph160bsWs = LDR_RequireWorksheet(sourceWb, LDR_PH160BS_SHEET, 7108)
    Set ph160asWs = LDR_RequireWorksheet(sourceWb, LDR_PH160AS_SHEET, 7109)

    Set loaderWb = LDR_FindOrOpenLoaderWorkbook(sourceWb, loaderNote)

    If loaderWb Is Nothing Then GoTo LDR_CleanUp

    If loaderWb.ReadOnly Then
        Err.Raise vbObjectError + 7101, _
                  "Load_PB_Differences_ValuesOnly", _
                  "PB Loader workbook is read-only."
    End If

    LDR_BuildContext ctx, loaderWb

    sourceWs.Calculate
    ph632Rt684Ws.Calculate
    rt624csWs.Calculate
    ph160bsWs.Calculate
    ph160asWs.Calculate

    ' Select the daily bucket from the actual Canadian run date. The source
    ' sheets can still display the prior report date, which otherwise makes
    ' Tuesday/Wednesday continue using the wrong weekend bucket. The same
    ' run date drives every sheet, so the mode is resolved once.
    runDate = Date
    runMode = LDR_GetProcessingMode(runDate, modeText)

    ' The run date is authoritative, but a run started a day late would pick
    ' the wrong bucket without any sign of it. Compare each source sheet's own
    ' report date against the previous business day and report a mismatch.
    dateNotes = LDR_CollectDateNotes( _
        runDate, ph632Rt684Ws, rt624csWs, ph160bsWs, ph160asWs)

    ' Source addresses per mode. The Monday and long-weekend layouts are not
    ' just a different column of the normal one: on PH632-RT684 they also sit
    ' one row higher, so the rows are selected per mode rather than shared.
    '   PH632M / RT684M PB interest (CAD first, USD on the next row):
    '     normal X3:X4 and X8:X9, Monday I2:I3 and I7:I8,
    '     long weekend J2:J3 and J7:J8.
    '   RT624CS stock loan / PB interest:
    '     normal M13:M14 and N3:N8, Monday E2:E3 and E11:E16,
    '     long weekend F2:F3 and F11:F16.
    '   PH160BS PB interest:
    '     normal P22:P23, Monday D23:D24, long weekend E23:E24.
    '   PH160AS PB interest:
    '     normal O6:O7, Monday E8:E9, long weekend F8:F9.
    Select Case runMode
        Case LDR_MODE_LONG_WEEKEND
            interestSourceColumn = "J"
            ph632InterestFirstRow = 2
            rt684InterestFirstRow = 7
            rt624csStockColumn = "F"
            rt624csStockFirstRow = 2
            rt624csInterestColumn = "F"
            rt624csInterestFirstRow = 11
            ph160bsCadAddress = "E23"
            ph160bsUsdAddress = "E24"
            ph160asUsdInterestAddress = "F8"
            ph160asCadInterestAddress = "F9"

        Case LDR_MODE_MONDAY
            interestSourceColumn = "I"
            ph632InterestFirstRow = 2
            rt684InterestFirstRow = 7
            rt624csStockColumn = "E"
            rt624csStockFirstRow = 2
            rt624csInterestColumn = "E"
            rt624csInterestFirstRow = 11
            ph160bsCadAddress = "D23"
            ph160bsUsdAddress = "D24"
            ph160asUsdInterestAddress = "E8"
            ph160asCadInterestAddress = "E9"

        Case Else
            interestSourceColumn = "X"
            ph632InterestFirstRow = 3
            rt684InterestFirstRow = 8
            rt624csStockColumn = "M"
            rt624csStockFirstRow = 13
            rt624csInterestColumn = "N"
            rt624csInterestFirstRow = 3
            ph160bsCadAddress = "P22"
            ph160bsUsdAddress = "P23"
            ph160asUsdInterestAddress = "O6"
            ph160asCadInterestAddress = "O7"
    End Select

    ' RT624BS PB interest: source currency S17:S28, difference V17:V28.
    LDR_QueueRange ctx, sourceWs, 17, 28, "RT624BS", "PBINTEREST"

    ' RT624BS stock loan: source currency S3:S14, difference V3:V14.
    LDR_QueueRange ctx, sourceWs, 3, 14, "RT624BS", "STOCKLOANFEE"

    ' New Scotia PB-interest funds. Currency is read from column S.
    LDR_QueueOne ctx, sourceWs, 42, "RT730AS", "PBINTEREST"
    LDR_QueueOne ctx, sourceWs, 47, "RT730BS", "PBINTEREST"
    LDR_QueueOne ctx, sourceWs, 50, "RT731AS", "PBINTEREST"
    LDR_QueueOne ctx, sourceWs, 53, "RT731BS", "PBINTEREST"
    LDR_QueueOne ctx, sourceWs, 56, "RT732AS", "PBINTEREST"
    LDR_QueueOne ctx, sourceWs, 59, "RT732BS", "PBINTEREST"

    ' PH632M stock-loan differences.
    LDR_QueueFixedCell ctx, ph632Rt684Ws, "T3", "CAD", "PH632M", "STOCKLOANFEE"
    LDR_QueueFixedCell ctx, ph632Rt684Ws, "T4", "USD", "PH632M", "STOCKLOANFEE"

    ' PH632M PB interest: X3:X4 normally, I2:I3 on Monday, J2:J3 after a
    ' Canadian long weekend.
    LDR_QueueFixedCell ctx, ph632Rt684Ws, _
                       interestSourceColumn & CStr(ph632InterestFirstRow), _
                       "CAD", "PH632M", "PBINTEREST"
    LDR_QueueFixedCell ctx, ph632Rt684Ws, _
                       interestSourceColumn & CStr(ph632InterestFirstRow + 1), _
                       "USD", "PH632M", "PBINTEREST"

    ' RT684M stock-loan differences.
    LDR_QueueFixedCell ctx, ph632Rt684Ws, "T8", "CAD", "RT684M", "STOCKLOANFEE"
    LDR_QueueFixedCell ctx, ph632Rt684Ws, "T9", "USD", "RT684M", "STOCKLOANFEE"

    ' RT684M PB interest uses the same date rule: X8:X9 normally,
    ' I7:I8 on Monday, J7:J8 after a Canadian long weekend.
    LDR_QueueFixedCell ctx, ph632Rt684Ws, _
                       interestSourceColumn & CStr(rt684InterestFirstRow), _
                       "CAD", "RT684M", "PBINTEREST"
    LDR_QueueFixedCell ctx, ph632Rt684Ws, _
                       interestSourceColumn & CStr(rt684InterestFirstRow + 1), _
                       "USD", "RT684M", "PBINTEREST"

    ' RT624CS stock loan.
    LDR_QueueFixedCell ctx, rt624csWs, _
                       rt624csStockColumn & CStr(rt624csStockFirstRow), _
                       "JPY", "RT624CS", "STOCKLOANFEE"
    LDR_QueueFixedCell ctx, rt624csWs, _
                       rt624csStockColumn & CStr(rt624csStockFirstRow + 1), _
                       "SGD", "RT624CS", "STOCKLOANFEE"

    ' RT624CS PB interest currencies, in source-row order.
    rt624csCurrencies = Array("HKD", "JPY", "NZD", "SGD", "USD", "AUD")

    For mappingIndex = LBound(rt624csCurrencies) To UBound(rt624csCurrencies)

        LDR_QueueFixedCell ctx, rt624csWs, _
                           rt624csInterestColumn & _
                           CStr(rt624csInterestFirstRow + mappingIndex), _
                           CStr(rt624csCurrencies(mappingIndex)), _
                           "RT624CS", "PBINTEREST"
    Next mappingIndex

    ' PH160BS PB interest.
    LDR_QueueFixedCell ctx, ph160bsWs, ph160bsCadAddress, _
                       "CAD", "PH160BS", "PBINTEREST"
    LDR_QueueFixedCell ctx, ph160bsWs, ph160bsUsdAddress, _
                       "USD", "PH160BS", "PBINTEREST"

    ' PH160AS is driven directly from the four existing PH160AS
    ' loader rows. This avoids a silent miss caused by label formatting.
    LDR_QueuePH160ASRows ctx, ph160asWs, _
                         ph160asUsdInterestAddress, _
                         ph160asCadInterestAddress

    LDR_LogRun ctx, loaderWb, runDate, modeText, dateNotes

    ' Preflight finishes before any loader cell is changed.
    If Len(ctx.Problems) > 0 Then
        Err.Raise vbObjectError + 7105, _
                  "Load_PB_Differences_ValuesOnly", _
                  "Nothing was written because:" & vbCrLf & _
                  LDR_CapText(ctx.Problems, LDR_MAX_MESSAGE_LINES)
    End If

    ' Cancelled, or nothing matched. Either way ConfirmWrite has already said
    ' so, and no loader cell has been touched.
    If Not LDR_ConfirmWrite( _
        ctx, loaderWb, loaderNote, runDate, modeText, dateNotes) Then

        GoTo LDR_CleanUp
    End If

    oldScreenUpdating = Application.ScreenUpdating
    oldEnableEvents = Application.EnableEvents
    oldCalculation = Application.Calculation
    settingsChanged = True

    Application.ScreenUpdating = False
    Application.EnableEvents = False
    Application.Calculation = xlCalculationManual

    ' Value-only write. No Copy/PasteSpecial is used.
    For i = 1 To ctx.TargetCells.Count
        Set targetCell = ctx.TargetCells(i)
        targetCell.Value2 = CDbl(ctx.TargetValues(i))
        writtenCount = writtenCount + 1
    Next i

    loaderWb.Activate
    ctx.LoaderWs.Activate

LDR_CleanUp:
    On Error Resume Next
    Application.CutCopyMode = False

    If settingsChanged Then
        Application.Calculation = oldCalculation
        Application.EnableEvents = oldEnableEvents
        Application.ScreenUpdating = oldScreenUpdating
    End If

    On Error GoTo 0

    ' One box, same text, whatever happened. Anything that went wrong is in
    ' the Immediate window (Ctrl+G).
    If Len(errorText) > 0 Then Debug.Print errorText

    MsgBox "Paste Done", vbInformation, "PB Loader"

    Exit Sub

LDR_Failed:
    errorText = "Loader stopped: " & Err.Description

    ' Say how far the write got. Anything already written stays written.
    If writtenCount > 0 Then
        errorText = errorText & vbCrLf & vbCrLf & _
                    CStr(writtenCount) & " of " & _
                    CStr(ctx.TargetCells.Count) & _
                    " values had already been written." & vbCrLf & _
                    "Last mapping written: " & _
                    CStr(ctx.TargetDetails(writtenCount))
    End If

    Resume LDR_CleanUp
End Sub

' ---------------------------------------------------------------------------
' Loader context
' ---------------------------------------------------------------------------

' Reads the loader key columns once. Every later lookup is a dictionary hit
' instead of a fresh sweep of the sheet.
Private Sub LDR_BuildContext(ByRef ctx As LDR_Context, _
                             ByVal loaderWb As Workbook)
    Dim rowNumber As Long
    Dim offsetIndex As Long
    Dim keyText As String

    Set ctx.LoaderWs = LDR_GetWorksheetFlexible(loaderWb, LDR_TARGET_SHEET)
    If ctx.LoaderWs Is Nothing Then
        Err.Raise vbObjectError + 7102, _
                  "Load_PB_Differences_ValuesOnly", _
                  "Loader tab not found: " & LDR_TARGET_SHEET
    End If

    If ctx.LoaderWs.ProtectContents Then
        Err.Raise vbObjectError + 7103, _
                  "Load_PB_Differences_ValuesOnly", _
                  "Loader tab is protected: " & ctx.LoaderWs.Name
    End If

    ctx.HeaderRow = LDR_FindHeaderRow(ctx.LoaderWs)
    If ctx.HeaderRow = 0 Then
        Err.Raise vbObjectError + 7104, _
                  "Load_PB_Differences_ValuesOnly", _
                  "ENTITY ID / AMOUNT / CURRENCY / ANNOTATION headers were not found."
    End If

    ctx.EntityColumn = LDR_FindHeaderColumn(ctx.LoaderWs, ctx.HeaderRow, "entityid")
    ctx.AmountColumn = LDR_FindHeaderColumn(ctx.LoaderWs, ctx.HeaderRow, "amount")
    ctx.CurrencyColumn = LDR_FindHeaderColumn(ctx.LoaderWs, ctx.HeaderRow, "currency")
    ctx.AnnotationColumn = LDR_FindHeaderColumn(ctx.LoaderWs, ctx.HeaderRow, "annotation")

    ' Partial header matching can land two tokens on one column, which would
    ' send amounts into a key column.
    If LDR_HasRepeatedColumn(ctx) Then
        Err.Raise vbObjectError + 7110, _
                  "Load_PB_Differences_ValuesOnly", _
                  "Two of the ENTITY ID / AMOUNT / CURRENCY / ANNOTATION " & _
                  "headers resolved to the same column on row " & _
                  CStr(ctx.HeaderRow) & ". Rename the headers so each is distinct."
    End If

    ctx.FirstDataRow = ctx.HeaderRow + 1
    ctx.LastRow = LDR_LastUsedRow(ctx.LoaderWs)

    Set ctx.RowIndex = CreateObject("Scripting.Dictionary")
    Set ctx.TargetIndex = CreateObject("Scripting.Dictionary")
    Set ctx.TargetCells = New Collection
    Set ctx.TargetValues = New Collection
    Set ctx.TargetDetails = New Collection

    If ctx.LastRow < ctx.FirstDataRow Then Exit Sub

    ctx.EntityValues = LDR_ColumnValues( _
        ctx.LoaderWs, ctx.EntityColumn, ctx.FirstDataRow, ctx.LastRow)
    ctx.CurrencyValues = LDR_ColumnValues( _
        ctx.LoaderWs, ctx.CurrencyColumn, ctx.FirstDataRow, ctx.LastRow)
    ctx.AnnotationValues = LDR_ColumnValues( _
        ctx.LoaderWs, ctx.AnnotationColumn, ctx.FirstDataRow, ctx.LastRow)

    For offsetIndex = 1 To UBound(ctx.EntityValues)
        rowNumber = ctx.FirstDataRow + offsetIndex - 1
        keyText = LDR_RowKey(ctx, offsetIndex)

        If Len(Replace(keyText, "|", "")) > 0 Then
            If ctx.RowIndex.Exists(keyText) Then
                ' Only the first row of a repeated key was ever updated, so
                ' the later ones keep the amount from an earlier run.
                LDR_AddWarning ctx, _
                    "Loader rows " & CStr(ctx.RowIndex(keyText)) & " and " & _
                    CStr(rowNumber) & " have the same ENTITY ID / CURRENCY / " & _
                    "ANNOTATION; only row " & CStr(ctx.RowIndex(keyText)) & _
                    " is updated."
            Else
                ctx.RowIndex.Add keyText, rowNumber
            End If
        End If
    Next offsetIndex
End Sub

Private Function LDR_HasRepeatedColumn(ByRef ctx As LDR_Context) As Boolean
    If ctx.EntityColumn = ctx.AmountColumn _
       Or ctx.EntityColumn = ctx.CurrencyColumn _
       Or ctx.EntityColumn = ctx.AnnotationColumn _
       Or ctx.AmountColumn = ctx.CurrencyColumn _
       Or ctx.AmountColumn = ctx.AnnotationColumn _
       Or ctx.CurrencyColumn = ctx.AnnotationColumn Then

        LDR_HasRepeatedColumn = True
    End If
End Function

Private Function LDR_RowKey(ByRef ctx As LDR_Context, _
                            ByVal offsetIndex As Long) As String

    LDR_RowKey = LDR_MakeKey( _
        LDR_SafeText(ctx.EntityValues(offsetIndex)), _
        LDR_SafeText(ctx.CurrencyValues(offsetIndex)), _
        LDR_SafeText(ctx.AnnotationValues(offsetIndex)))
End Function

Private Function LDR_MakeKey(ByVal entityId As String, _
                             ByVal currencyText As String, _
                             ByVal annotationText As String) As String

    LDR_MakeKey = LDR_NormalizeText(entityId) & "|" & _
                  LDR_NormalizeText(currencyText) & "|" & _
                  LDR_NormalizeText(annotationText)
End Function

' ---------------------------------------------------------------------------
' Queueing
' ---------------------------------------------------------------------------

Private Sub LDR_QueueRange(ByRef ctx As LDR_Context, _
                           ByVal sourceWs As Worksheet, _
                           ByVal firstSourceRow As Long, _
                           ByVal lastSourceRow As Long, _
                           ByVal entityId As String, _
                           ByVal annotationText As String)
    Dim sourceRow As Long

    For sourceRow = firstSourceRow To lastSourceRow
        LDR_QueueOne ctx, sourceWs, sourceRow, entityId, annotationText
    Next sourceRow
End Sub

' Difference in column V, currency in column S of the same row.
Private Sub LDR_QueueOne(ByRef ctx As LDR_Context, _
                         ByVal sourceWs As Worksheet, _
                         ByVal sourceRow As Long, _
                         ByVal entityId As String, _
                         ByVal annotationText As String)
    Dim reading As LDR_Reading
    Dim currencyText As String

    currencyText = UCase$(Trim$(LDR_SafeText( _
        sourceWs.Range("S" & CStr(sourceRow)).Value2)))

    reading = LDR_ReadCell(sourceWs.Range("V" & CStr(sourceRow)))

    ' A row with neither a currency nor a difference is an unused row in the
    ' source block, not a mapping that went missing.
    If Len(currencyText) = 0 And reading.Status = LDR_READ_BLANK Then Exit Sub

    If Len(currencyText) = 0 Then
        LDR_AddProblem ctx, _
            "Currency is blank in S" & CStr(sourceRow) & " for " & entityId & "."
        Exit Sub
    End If

    LDR_QueueValue ctx, entityId, currencyText, annotationText, reading, _
                   sourceWs.Name & "!V" & CStr(sourceRow)
End Sub

' Difference at a fixed address, currency supplied by the caller.
Private Sub LDR_QueueFixedCell(ByRef ctx As LDR_Context, _
                               ByVal sourceWs As Worksheet, _
                               ByVal sourceAddress As String, _
                               ByVal currencyText As String, _
                               ByVal entityId As String, _
                               ByVal annotationText As String)
    Dim reading As LDR_Reading

    reading = LDR_ReadCell(sourceWs.Range(sourceAddress))

    LDR_QueueValue ctx, entityId, UCase$(Trim$(currencyText)), annotationText, _
                   reading, sourceWs.Name & "!" & sourceAddress
End Sub

Private Sub LDR_QueuePH160ASRows(ByRef ctx As LDR_Context, _
                                 ByVal sourceWs As Worksheet, _
                                 ByVal usdInterestAddress As String, _
                                 ByVal cadInterestAddress As String)

    Dim offsetIndex As Long
    Dim rowNumber As Long
    Dim currencyText As String
    Dim annotationText As String
    Dim sourceAddress As String
    Dim reading As LDR_Reading

    If ctx.LastRow < ctx.FirstDataRow Then Exit Sub

    For offsetIndex = 1 To UBound(ctx.EntityValues)

        If LDR_NormalizeText(LDR_SafeText(ctx.EntityValues(offsetIndex))) = _
           LDR_NormalizeText("PH160AS") Then

            rowNumber = ctx.FirstDataRow + offsetIndex - 1
            currencyText = UCase$(Trim$( _
                LDR_SafeText(ctx.CurrencyValues(offsetIndex))))
            annotationText = LDR_NormalizeText( _
                LDR_SafeText(ctx.AnnotationValues(offsetIndex)))

            sourceAddress = vbNullString

            If InStr(1, annotationText, "stockloan", vbTextCompare) > 0 Then

                Select Case LDR_NormalizeText(currencyText)
                    Case "usd"
                        sourceAddress = "O2"
                    Case "cad"
                        sourceAddress = "O3"
                End Select

            ElseIf InStr(1, annotationText, "interest", vbTextCompare) > 0 Then

                Select Case LDR_NormalizeText(currencyText)
                    Case "usd"
                        sourceAddress = usdInterestAddress
                    Case "cad"
                        sourceAddress = cadInterestAddress
                End Select
            End If

            If Len(sourceAddress) > 0 Then
                reading = LDR_ReadCell(sourceWs.Range(sourceAddress))

                LDR_QueueValueAtRow ctx, rowNumber, _
                    "PH160AS / " & currencyText & " / " & annotationText & _
                    " from " & sourceWs.Name & "!" & sourceAddress, _
                    reading
            End If
        End If
    Next offsetIndex
End Sub

' Resolves the loader row for a mapping, then hands over to the row-level
' queue. Everything that cannot be queued is recorded, never dropped.
Private Sub LDR_QueueValue(ByRef ctx As LDR_Context, _
                           ByVal entityId As String, _
                           ByVal currencyText As String, _
                           ByVal annotationText As String, _
                           ByRef reading As LDR_Reading, _
                           ByVal sourceLabel As String)
    Dim keyText As String
    Dim detailText As String

    detailText = entityId & " / " & currencyText & " / " & annotationText & _
                 " from " & sourceLabel

    keyText = LDR_MakeKey(entityId, currencyText, annotationText)

    If Not ctx.RowIndex.Exists(keyText) Then
        ' No loader row for this combination. Not fatal, but the source value
        ' is going nowhere and the run should say so.
        If reading.Status = LDR_READ_BLANK Then
            LDR_AddWarning ctx, detailText & _
                " - no matching loader row (source cell is empty)."
        Else
            LDR_AddWarning ctx, detailText & " - no matching loader row."
        End If
        Exit Sub
    End If

    LDR_QueueValueAtRow ctx, ctx.RowIndex(keyText), detailText, reading
End Sub

Private Sub LDR_QueueValueAtRow(ByRef ctx As LDR_Context, _
                                ByVal loaderRow As Long, _
                                ByVal detailText As String, _
                                ByRef reading As LDR_Reading)
    Dim amountCell As Range
    Dim addressText As String
    Dim reasonText As String

    Select Case reading.Status
        Case LDR_READ_ERROR
            reasonText = "source cell holds " & reading.DisplayText

        Case LDR_READ_TEXT
            reasonText = "source cell is not a number (""" & _
                         reading.DisplayText & """)"

        Case LDR_READ_BLANK
            reasonText = "source cell is empty"
    End Select

    ' One unreadable cell is one mapping that cannot load. The others still
    ' can, so this is reported rather than treated as a reason to stop.
    If Len(reasonText) > 0 Then
        If reading.Status <> LDR_READ_BLANK _
           And LDR_STOP_ON_UNREADABLE_SOURCE Then

            LDR_AddProblem ctx, _
                UCase$(Left$(reasonText, 1)) & Mid$(reasonText, 2) & _
                ". Mapping: " & detailText & "."
        Else
            LDR_AddWarning ctx, detailText & " - " & reasonText & _
                "; loader row " & CStr(loaderRow) & " was left unchanged."
        End If
        Exit Sub
    End If

    If reading.Value = 0 And Not LDR_WRITE_ZERO_DIFFERENCES Then
        LDR_AddWarning ctx, detailText & _
            " - difference is 0.00; loader row " & CStr(loaderRow) & _
            " was left unchanged."
        Exit Sub
    End If

    Set amountCell = ctx.LoaderWs.Cells(loaderRow, ctx.AmountColumn)
    addressText = amountCell.Address(False, False)

    ' Protect an existing formula in the destination AMOUNT cell.
    If amountCell.HasFormula Then
        LDR_AddProblem ctx, _
            "Formula found in " & addressText & "; it was protected. Mapping: " & _
            detailText & "."
        Exit Sub
    End If

    ' Two mappings on one cell means the second write silently replaced the
    ' first. Stop instead, and name both mappings.
    If ctx.TargetIndex.Exists(addressText) Then
        LDR_AddProblem ctx, _
            "Two mappings both write to " & addressText & ": " & _
            CStr(ctx.TargetIndex(addressText)) & " and " & detailText & "."
        Exit Sub
    End If

    ctx.TargetIndex.Add addressText, detailText
    ctx.TargetCells.Add amountCell
    ctx.TargetValues.Add reading.Value
    ctx.TargetDetails.Add detailText
End Sub

Private Sub LDR_AddProblem(ByRef ctx As LDR_Context, ByVal messageText As String)
    ctx.Problems = ctx.Problems & "- " & messageText & vbCrLf
End Sub

Private Sub LDR_AddWarning(ByRef ctx As LDR_Context, ByVal messageText As String)
    ctx.Warnings = ctx.Warnings & "- " & messageText & vbCrLf
    ctx.WarningCount = ctx.WarningCount + 1
End Sub

