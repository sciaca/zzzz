Option Explicit

' Paste this code into a NEW standard VBA module.
' Run: Load_PB_Differences_ValuesOnly
'
' This macro writes VALUES ONLY to the loader AMOUNT column.
' It does not insert/delete rows, copy formats, or change formulas.

Private Const LDR_SOURCE_SHEET As String = "Scotia - RT624BSPh160CS"
Private Const LDR_PH632_RT684_SHEET As String = "PH632-RT684"
Private Const LDR_RT624CS_SHEET As String = "SOCGEN_RT624CS"
Private Const LDR_PH160BS_SHEET As String = "PH191S-PH160BS"
Private Const LDR_PH160AS_SHEET As String = "PH160AS - CASH JOURNAL"
Private Const LDR_TARGET_SHEET As String = "TEMPLATE"
Private Const LDR_CODE_VERSION As String = "2026-07-23-PH160AS-v2"

Private Const LDR_MODE_NORMAL As Long = 0
Private Const LDR_MODE_MONDAY As Long = 1
Private Const LDR_MODE_LONG_WEEKEND As Long = 2

Public Sub Load_PB_Differences_ValuesOnly()
    Dim sourceWb As Workbook
    Dim sourceWs As Worksheet
    Dim ph632Rt684Ws As Worksheet
    Dim rt624csWs As Worksheet
    Dim ph160bsWs As Worksheet
    Dim ph160asWs As Worksheet
    Dim loaderWb As Workbook
    Dim loaderWs As Worksheet

    Dim headerRow As Long
    Dim entityColumn As Long
    Dim amountColumn As Long
    Dim currencyColumn As Long
    Dim annotationColumn As Long

    Dim targetCells As Collection
    Dim targetValues As Collection
    Dim targetDetails As Collection
    Dim problems As String
    Dim interestSourceColumn As String
    Dim interestModeText As String
    Dim processingDate As Date
    Dim rt624csProcessingDate As Date
    Dim rt624csMode As Long
    Dim rt624csModeText As String
    Dim rt624csStockColumn As String
    Dim rt624csStockFirstRow As Long
    Dim rt624csInterestColumn As String
    Dim rt624csInterestFirstRow As Long
    Dim rt624csCurrencies As Variant
    Dim mappingIndex As Long
    Dim ph160bsProcessingDate As Date
    Dim ph160bsMode As Long
    Dim ph160bsModeText As String
    Dim ph160bsCadAddress As String
    Dim ph160bsUsdAddress As String
    Dim ph160asProcessingDate As Date
    Dim ph160asMode As Long
    Dim ph160asModeText As String
    Dim ph160asUsdInterestAddress As String
    Dim ph160asCadInterestAddress As String

    Dim i As Long
    Dim targetCell As Range
    Dim oldScreenUpdating As Boolean
    Dim oldEnableEvents As Boolean
    Dim settingsChanged As Boolean
    Dim errorText As String

    On Error GoTo LDR_Failed

    Set sourceWb = LDR_FindOrOpenSourceWorkbook()
    If sourceWb Is Nothing Then Exit Sub

    Set sourceWs = LDR_GetWorksheetFlexible(sourceWb, LDR_SOURCE_SHEET)
    If sourceWs Is Nothing Then
        Err.Raise vbObjectError + 7100, _
                  "Load_PB_Differences_ValuesOnly", _
                  "Source tab not found: " & LDR_SOURCE_SHEET
    End If

    Set ph632Rt684Ws = LDR_GetWorksheetFlexible( _
        sourceWb, LDR_PH632_RT684_SHEET)

    If ph632Rt684Ws Is Nothing Then
        Err.Raise vbObjectError + 7106, _
                  "Load_PB_Differences_ValuesOnly", _
                  "Source tab not found: " & LDR_PH632_RT684_SHEET
    End If

    Set rt624csWs = LDR_GetWorksheetFlexible( _
        sourceWb, LDR_RT624CS_SHEET)

    If rt624csWs Is Nothing Then
        Err.Raise vbObjectError + 7107, _
                  "Load_PB_Differences_ValuesOnly", _
                  "Source tab not found: " & LDR_RT624CS_SHEET
    End If

    Set ph160bsWs = LDR_GetWorksheetFlexible( _
        sourceWb, LDR_PH160BS_SHEET)

    If ph160bsWs Is Nothing Then
        Err.Raise vbObjectError + 7108, _
                  "Load_PB_Differences_ValuesOnly", _
                  "Source tab not found: " & LDR_PH160BS_SHEET
    End If

    Set ph160asWs = LDR_GetWorksheetFlexible( _
        sourceWb, LDR_PH160AS_SHEET)

    If ph160asWs Is Nothing Then
        Err.Raise vbObjectError + 7109, _
                  "Load_PB_Differences_ValuesOnly", _
                  "Source tab not found: " & LDR_PH160AS_SHEET
    End If

    Set loaderWb = LDR_FindOrOpenLoaderWorkbook(sourceWb)
    If loaderWb Is Nothing Then Exit Sub

    If loaderWb.ReadOnly Then
        Err.Raise vbObjectError + 7101, _
                  "Load_PB_Differences_ValuesOnly", _
                  "PB Loader workbook is read-only."
    End If

    Set loaderWs = LDR_GetWorksheetFlexible(loaderWb, LDR_TARGET_SHEET)
    If loaderWs Is Nothing Then
        Err.Raise vbObjectError + 7102, _
                  "Load_PB_Differences_ValuesOnly", _
                  "Loader tab not found: " & LDR_TARGET_SHEET
    End If

    If loaderWs.ProtectContents Then
        Err.Raise vbObjectError + 7103, _
                  "Load_PB_Differences_ValuesOnly", _
                  "Loader tab is protected: " & loaderWs.Name
    End If

    headerRow = LDR_FindHeaderRow(loaderWs)
    If headerRow = 0 Then
        Err.Raise vbObjectError + 7104, _
                  "Load_PB_Differences_ValuesOnly", _
                  "ENTITY ID / AMOUNT / CURRENCY / ANNOTATION headers were not found."
    End If

    entityColumn = LDR_FindHeaderColumn(loaderWs, headerRow, "entityid")
    amountColumn = LDR_FindHeaderColumn(loaderWs, headerRow, "amount")
    currencyColumn = LDR_FindHeaderColumn(loaderWs, headerRow, "currency")
    annotationColumn = LDR_FindHeaderColumn(loaderWs, headerRow, "annotation")

    sourceWs.Calculate
    ph632Rt684Ws.Calculate
    rt624csWs.Calculate
    ph160bsWs.Calculate
    ph160asWs.Calculate

    processingDate = LDR_GetPH632ProcessingDate(ph632Rt684Ws)
    interestSourceColumn = LDR_GetInterestSourceColumn( _
        processingDate, interestModeText)

    rt624csProcessingDate = LDR_GetRT624CSProcessingDate(rt624csWs)
    rt624csMode = LDR_GetProcessingMode( _
        rt624csProcessingDate, rt624csModeText)

    Select Case rt624csMode
        Case LDR_MODE_LONG_WEEKEND
            rt624csStockColumn = "F"
            rt624csStockFirstRow = 2
            rt624csInterestColumn = "F"
            rt624csInterestFirstRow = 11

        Case LDR_MODE_MONDAY
            rt624csStockColumn = "E"
            rt624csStockFirstRow = 2
            rt624csInterestColumn = "E"
            rt624csInterestFirstRow = 11

        Case Else
            rt624csStockColumn = "M"
            rt624csStockFirstRow = 13
            rt624csInterestColumn = "N"
            rt624csInterestFirstRow = 3
    End Select

    ph160bsProcessingDate = LDR_GetPH160BSProcessingDate(ph160bsWs)
    ph160bsMode = LDR_GetProcessingMode( _
        ph160bsProcessingDate, ph160bsModeText)

    Select Case ph160bsMode
        Case LDR_MODE_LONG_WEEKEND
            ph160bsCadAddress = "E23"
            ph160bsUsdAddress = "E24"

        Case LDR_MODE_MONDAY
            ph160bsCadAddress = "D23"
            ph160bsUsdAddress = "D24"

        Case Else
            ph160bsCadAddress = "P22"
            ph160bsUsdAddress = "P23"
    End Select

    ph160asProcessingDate = LDR_GetPH160ASProcessingDate(ph160asWs)
    ph160asMode = LDR_GetProcessingMode( _
        ph160asProcessingDate, ph160asModeText)

    Select Case ph160asMode
        Case LDR_MODE_LONG_WEEKEND
            ph160asUsdInterestAddress = "F7"
            ph160asCadInterestAddress = "F8"

        Case LDR_MODE_MONDAY
            ph160asUsdInterestAddress = "E7"
            ph160asCadInterestAddress = "E8"

        Case Else
            ph160asUsdInterestAddress = "O6"
            ph160asCadInterestAddress = "O7"
    End Select

    Set targetCells = New Collection
    Set targetValues = New Collection
    Set targetDetails = New Collection

    ' RT624BS PB interest: source currency S17:S28, difference V17:V28.
    LDR_QueueRange sourceWs, loaderWs, 17, 28, _
                   "RT624BS", "PBINTEREST", _
                   headerRow, entityColumn, amountColumn, _
                   currencyColumn, annotationColumn, _
                   targetCells, targetValues, targetDetails, problems

    ' RT624BS stock loan: source currency S3:S14, difference V3:V14.
    LDR_QueueRange sourceWs, loaderWs, 3, 14, _
                   "RT624BS", "STOCKLOANFEE", _
                   headerRow, entityColumn, amountColumn, _
                   currencyColumn, annotationColumn, _
                   targetCells, targetValues, targetDetails, problems

    ' New Scotia PB-interest funds. Currency is read from column S.
    LDR_QueueOne sourceWs, loaderWs, 42, _
                 "RT730AS", "PBINTEREST", _
                 headerRow, entityColumn, amountColumn, _
                 currencyColumn, annotationColumn, _
                 targetCells, targetValues, targetDetails, problems

    LDR_QueueOne sourceWs, loaderWs, 47, _
                 "RT730BS", "PBINTEREST", _
                 headerRow, entityColumn, amountColumn, _
                 currencyColumn, annotationColumn, _
                 targetCells, targetValues, targetDetails, problems

    LDR_QueueOne sourceWs, loaderWs, 50, _
                 "RT731AS", "PBINTEREST", _
                 headerRow, entityColumn, amountColumn, _
                 currencyColumn, annotationColumn, _
                 targetCells, targetValues, targetDetails, problems

    LDR_QueueOne sourceWs, loaderWs, 53, _
                 "RT731BS", "PBINTEREST", _
                 headerRow, entityColumn, amountColumn, _
                 currencyColumn, annotationColumn, _
                 targetCells, targetValues, targetDetails, problems

    LDR_QueueOne sourceWs, loaderWs, 56, _
                 "RT732AS", "PBINTEREST", _
                 headerRow, entityColumn, amountColumn, _
                 currencyColumn, annotationColumn, _
                 targetCells, targetValues, targetDetails, problems

    LDR_QueueOne sourceWs, loaderWs, 59, _
                 "RT732BS", "PBINTEREST", _
                 headerRow, entityColumn, amountColumn, _
                 currencyColumn, annotationColumn, _
                 targetCells, targetValues, targetDetails, problems

    ' PH632M stock-loan differences.
    LDR_QueueFixedCell ph632Rt684Ws, loaderWs, "T3", "CAD", _
                       "PH632M", "STOCKLOANFEE", _
                       headerRow, entityColumn, amountColumn, _
                       currencyColumn, annotationColumn, _
                       targetCells, targetValues, targetDetails, problems

    LDR_QueueFixedCell ph632Rt684Ws, loaderWs, "T4", "USD", _
                       "PH632M", "STOCKLOANFEE", _
                       headerRow, entityColumn, amountColumn, _
                       currencyColumn, annotationColumn, _
                       targetCells, targetValues, targetDetails, problems

    ' PH632M PB interest: X normally, I on Monday, J after a
    ' Canadian long weekend.
    LDR_QueueFixedCell ph632Rt684Ws, loaderWs, _
                       interestSourceColumn & "3", "CAD", _
                       "PH632M", "PBINTEREST", _
                       headerRow, entityColumn, amountColumn, _
                       currencyColumn, annotationColumn, _
                       targetCells, targetValues, targetDetails, problems

    LDR_QueueFixedCell ph632Rt684Ws, loaderWs, _
                       interestSourceColumn & "4", "USD", _
                       "PH632M", "PBINTEREST", _
                       headerRow, entityColumn, amountColumn, _
                       currencyColumn, annotationColumn, _
                       targetCells, targetValues, targetDetails, problems

    ' RT684M stock-loan differences.
    LDR_QueueFixedCell ph632Rt684Ws, loaderWs, "T8", "CAD", _
                       "RT684M", "STOCKLOANFEE", _
                       headerRow, entityColumn, amountColumn, _
                       currencyColumn, annotationColumn, _
                       targetCells, targetValues, targetDetails, problems

    LDR_QueueFixedCell ph632Rt684Ws, loaderWs, "T9", "USD", _
                       "RT684M", "STOCKLOANFEE", _
                       headerRow, entityColumn, amountColumn, _
                       currencyColumn, annotationColumn, _
                       targetCells, targetValues, targetDetails, problems

    ' RT684M PB interest uses the same date rule.
    LDR_QueueFixedCell ph632Rt684Ws, loaderWs, _
                       interestSourceColumn & "8", "CAD", _
                       "RT684M", "PBINTEREST", _
                       headerRow, entityColumn, amountColumn, _
                       currencyColumn, annotationColumn, _
                       targetCells, targetValues, targetDetails, problems

    LDR_QueueFixedCell ph632Rt684Ws, loaderWs, _
                       interestSourceColumn & "9", "USD", _
                       "RT684M", "PBINTEREST", _
                       headerRow, entityColumn, amountColumn, _
                       currencyColumn, annotationColumn, _
                       targetCells, targetValues, targetDetails, problems

    ' RT624CS stock loan.
    ' Normal: M13:M14. Monday: E2:E3. Long weekend: F2:F3.
    LDR_QueueFixedCell rt624csWs, loaderWs, _
                       rt624csStockColumn & _
                       CStr(rt624csStockFirstRow), "JPY", _
                       "RT624CS", "STOCKLOANFEE", _
                       headerRow, entityColumn, amountColumn, _
                       currencyColumn, annotationColumn, _
                       targetCells, targetValues, targetDetails, problems

    LDR_QueueFixedCell rt624csWs, loaderWs, _
                       rt624csStockColumn & _
                       CStr(rt624csStockFirstRow + 1), "SGD", _
                       "RT624CS", "STOCKLOANFEE", _
                       headerRow, entityColumn, amountColumn, _
                       currencyColumn, annotationColumn, _
                       targetCells, targetValues, targetDetails, problems

    ' RT624CS PB interest currencies, in source-row order.
    ' Normal: N3:N8. Monday: E11:E16. Long weekend: F11:F16.
    rt624csCurrencies = Array( _
        "HKD", "JPY", "NZD", "SGD", "USD", "AUD")

    For mappingIndex = LBound(rt624csCurrencies) To UBound(rt624csCurrencies)

        LDR_QueueFixedCell rt624csWs, loaderWs, _
                           rt624csInterestColumn & _
                           CStr(rt624csInterestFirstRow + mappingIndex), _
                           CStr(rt624csCurrencies(mappingIndex)), _
                           "RT624CS", "PBINTEREST", _
                           headerRow, entityColumn, amountColumn, _
                           currencyColumn, annotationColumn, _
                           targetCells, targetValues, targetDetails, problems
    Next mappingIndex

    ' PH160BS PB interest.
    ' Normal: P22:P23. Monday: D23:D24.
    ' Canadian long weekend: E23:E24.
    LDR_QueueFixedCell ph160bsWs, loaderWs, _
                       ph160bsCadAddress, "CAD", _
                       "PH160BS", "PBINTEREST", _
                       headerRow, entityColumn, amountColumn, _
                       currencyColumn, annotationColumn, _
                       targetCells, targetValues, targetDetails, problems

    LDR_QueueFixedCell ph160bsWs, loaderWs, _
                       ph160bsUsdAddress, "USD", _
                       "PH160BS", "PBINTEREST", _
                       headerRow, entityColumn, amountColumn, _
                       currencyColumn, annotationColumn, _
                       targetCells, targetValues, targetDetails, problems

    ' PH160AS stock loan always uses the normal difference cells.
    LDR_QueueFixedCell ph160asWs, loaderWs, "O2", "USD", _
                       "PH160AS", "STOCKLOANFEE", _
                       headerRow, entityColumn, amountColumn, _
                       currencyColumn, annotationColumn, _
                       targetCells, targetValues, targetDetails, problems, -1

    LDR_QueueFixedCell ph160asWs, loaderWs, "O3", "CAD", _
                       "PH160AS", "STOCKLOANFEE", _
                       headerRow, entityColumn, amountColumn, _
                       currencyColumn, annotationColumn, _
                       targetCells, targetValues, targetDetails, problems, -1

    ' PH160AS PB interest only:
    ' Normal O6:O7, Monday E7:E8, Canadian long weekend F7:F8.
    LDR_QueueFixedCell ph160asWs, loaderWs, _
                       ph160asUsdInterestAddress, "USD", _
                       "PH160AS", "PBINTEREST", _
                       headerRow, entityColumn, amountColumn, _
                       currencyColumn, annotationColumn, _
                       targetCells, targetValues, targetDetails, problems, -1

    LDR_QueueFixedCell ph160asWs, loaderWs, _
                       ph160asCadInterestAddress, "CAD", _
                       "PH160AS", "PBINTEREST", _
                       headerRow, entityColumn, amountColumn, _
                       currencyColumn, annotationColumn, _
                       targetCells, targetValues, targetDetails, problems, -1

    ' Preflight finishes before any loader cell is changed.
    If Len(problems) > 0 Then
        Err.Raise vbObjectError + 7105, _
                  "Load_PB_Differences_ValuesOnly", _
                  "Nothing was written because:" & vbCrLf & problems
    End If

    If targetCells.Count = 0 Then
        MsgBox "No usable difference values were found.", _
               vbInformation, "PB Loader"
        Exit Sub
    End If

    oldScreenUpdating = Application.ScreenUpdating
    oldEnableEvents = Application.EnableEvents
    settingsChanged = True

    Application.ScreenUpdating = False
    Application.EnableEvents = False

    ' Value-only write. No Copy/PasteSpecial is used.
    For i = 1 To targetCells.Count
        Set targetCell = targetCells(i)
        targetCell.Value2 = CDbl(targetValues(i))
    Next i

    loaderWb.Activate
    loaderWs.Activate

LDR_CleanUp:
    On Error Resume Next
    Application.CutCopyMode = False

    If settingsChanged Then
        Application.EnableEvents = oldEnableEvents
        Application.ScreenUpdating = oldScreenUpdating
    End If

    On Error GoTo 0

    If Len(errorText) > 0 Then
        MsgBox errorText, vbExclamation, "PB Loader"
    ElseIf Not targetCells Is Nothing Then
        If targetCells.Count > 0 Then
            MsgBox CStr(targetCells.Count) & _
                   " difference values were written to " & _
                   loaderWb.Name & " / " & loaderWs.Name & "." & vbCrLf & _
                   "Code version: " & LDR_CODE_VERSION & "." & vbCrLf & _
                   "PH632M/RT684M interest source: " & _
                   interestModeText & " for " & _
                   Format$(processingDate, "yyyy-mm-dd") & "." & vbCrLf & _
                   "RT624CS source: " & _
                   rt624csModeText & " for " & _
                   Format$(rt624csProcessingDate, "yyyy-mm-dd") & "." & vbCrLf & _
                   "PH160BS source: " & _
                   ph160bsModeText & " for " & _
                   Format$(ph160bsProcessingDate, "yyyy-mm-dd") & "." & vbCrLf & _
                   "PH160AS interest source: " & _
                   ph160asModeText & " for " & _
                   Format$(ph160asProcessingDate, "yyyy-mm-dd") & "." & vbCrLf & _
                   "Only the AMOUNT cells were changed.", _
                   vbInformation, "PB Loader"
        End If
    End If

    Exit Sub

LDR_Failed:
    errorText = "Loader stopped: " & Err.Description
    Resume LDR_CleanUp
End Sub

Private Sub LDR_QueueRange(ByVal sourceWs As Worksheet, _
                           ByVal loaderWs As Worksheet, _
                           ByVal firstSourceRow As Long, _
                           ByVal lastSourceRow As Long, _
                           ByVal entityId As String, _
                           ByVal annotationText As String, _
                           ByVal headerRow As Long, _
                           ByVal entityColumn As Long, _
                           ByVal amountColumn As Long, _
                           ByVal currencyColumn As Long, _
                           ByVal annotationColumn As Long, _
                           ByVal targetCells As Collection, _
                           ByVal targetValues As Collection, _
                           ByVal targetDetails As Collection, _
                           ByRef problems As String)
    Dim sourceRow As Long

    For sourceRow = firstSourceRow To lastSourceRow
        LDR_QueueOne sourceWs, loaderWs, sourceRow, _
                     entityId, annotationText, _
                     headerRow, entityColumn, amountColumn, _
                     currencyColumn, annotationColumn, _
                     targetCells, targetValues, targetDetails, problems
    Next sourceRow
End Sub

Private Sub LDR_QueueOne(ByVal sourceWs As Worksheet, _
                         ByVal loaderWs As Worksheet, _
                         ByVal sourceRow As Long, _
                         ByVal entityId As String, _
                         ByVal annotationText As String, _
                         ByVal headerRow As Long, _
                         ByVal entityColumn As Long, _
                         ByVal amountColumn As Long, _
                         ByVal currencyColumn As Long, _
                         ByVal annotationColumn As Long, _
                         ByVal targetCells As Collection, _
                         ByVal targetValues As Collection, _
                         ByVal targetDetails As Collection, _
                         ByRef problems As String)
    Dim differenceValue As Double
    Dim currencyText As String
    Dim loaderRow As Long
    Dim amountCell As Range
    Dim detailText As String

    If Not LDR_TryReadDifference( _
        sourceWs.Range("V" & CStr(sourceRow)).Value2, differenceValue) Then
        Exit Sub
    End If

    currencyText = UCase$(Trim$(CStr( _
        sourceWs.Range("S" & CStr(sourceRow)).Value2)))

    detailText = entityId & " / " & currencyText & _
                 " / " & annotationText & _
                 " from V" & CStr(sourceRow)

    If Len(currencyText) = 0 Then
        problems = problems & "- Currency is blank in S" & _
                   CStr(sourceRow) & " for " & entityId & "." & vbCrLf
        Exit Sub
    End If

    loaderRow = LDR_FindMatchRow( _
        loaderWs, headerRow, entityColumn, currencyColumn, _
        annotationColumn, entityId, currencyText, annotationText)

    ' No matching loader row means this combination has no loader data.
    If loaderRow = 0 Then Exit Sub

    Set amountCell = loaderWs.Cells(loaderRow, amountColumn)

    ' Protect an existing formula in the destination AMOUNT cell.
    If amountCell.HasFormula Then
        problems = problems & "- Formula found in " & _
                   amountCell.Address(False, False) & _
                   "; it was protected. Mapping: " & _
                   detailText & "." & vbCrLf
        Exit Sub
    End If

    targetCells.Add amountCell
    targetValues.Add differenceValue
    targetDetails.Add detailText
End Sub

Private Sub LDR_QueueFixedCell(ByVal sourceWs As Worksheet, _
                               ByVal loaderWs As Worksheet, _
                               ByVal sourceAddress As String, _
                               ByVal currencyText As String, _
                               ByVal entityId As String, _
                               ByVal annotationText As String, _
                               ByVal headerRow As Long, _
                               ByVal entityColumn As Long, _
                               ByVal amountColumn As Long, _
                               ByVal currencyColumn As Long, _
                               ByVal annotationColumn As Long, _
                               ByVal targetCells As Collection, _
                               ByVal targetValues As Collection, _
                               ByVal targetDetails As Collection, _
                               ByRef problems As String, _
                               Optional ByVal valueMultiplier As Double = 1)
    Dim differenceValue As Double
    Dim loaderRow As Long
    Dim amountCell As Range
    Dim detailText As String

    If Not LDR_TryReadDifference( _
        sourceWs.Range(sourceAddress).Value2, differenceValue, True) Then
        Exit Sub
    End If

    differenceValue = Application.WorksheetFunction.Round( _
        differenceValue * valueMultiplier, 2)

    currencyText = UCase$(Trim$(currencyText))
    detailText = entityId & " / " & currencyText & _
                 " / " & annotationText & _
                 " from " & sourceAddress

    loaderRow = LDR_FindMatchRow( _
        loaderWs, headerRow, entityColumn, currencyColumn, _
        annotationColumn, entityId, currencyText, annotationText)

    ' No matching loader row means this combination has no loader data.
    If loaderRow = 0 Then Exit Sub

    Set amountCell = loaderWs.Cells(loaderRow, amountColumn)

    If amountCell.HasFormula Then
        problems = problems & "- Formula found in " & _
                   amountCell.Address(False, False) & _
                   "; it was protected. Mapping: " & _
                   detailText & "." & vbCrLf
        Exit Sub
    End If

    targetCells.Add amountCell
    targetValues.Add differenceValue
    targetDetails.Add detailText
End Sub

Private Function LDR_TryReadDifference(ByVal rawValue As Variant, _
                                       ByRef resultValue As Double, _
                                       Optional ByVal includeZero As Boolean = False) _
                                       As Boolean
    Dim textValue As String
    Dim negativeValue As Boolean

    If IsError(rawValue) Or IsEmpty(rawValue) Then Exit Function

    If IsNumeric(rawValue) Then
        resultValue = CDbl(rawValue)
    Else
        textValue = Trim$(CStr(rawValue))

        If Len(textValue) = 0 Or textValue = "-" Then Exit Function

        textValue = Replace(textValue, ",", "")
        textValue = Replace(textValue, "$", "")
        textValue = Replace(textValue, " ", "")

        If Left$(textValue, 1) = "(" And _
           Right$(textValue, 1) = ")" Then
            negativeValue = True
            textValue = Mid$(textValue, 2, Len(textValue) - 2)
        End If

        If Not IsNumeric(textValue) Then Exit Function

        resultValue = CDbl(textValue)
        If negativeValue Then resultValue = -resultValue
    End If

    resultValue = Application.WorksheetFunction.Round(resultValue, 2)

    If includeZero Then
        LDR_TryReadDifference = True
    ElseIf Abs(resultValue) >= 0.01 Then
        LDR_TryReadDifference = True
    End If
End Function

Private Function LDR_GetPH632ProcessingDate( _
    ByVal sourceWs As Worksheet) As Date

    If IsDate(sourceWs.Range("H1").Value) Then
        LDR_GetPH632ProcessingDate = _
            DateValue(sourceWs.Range("H1").Value)
    ElseIf IsDate(sourceWs.Range("H6").Value) Then
        LDR_GetPH632ProcessingDate = _
            DateValue(sourceWs.Range("H6").Value)
    Else
        LDR_GetPH632ProcessingDate = Date
    End If
End Function

Private Function LDR_GetRT624CSProcessingDate( _
    ByVal sourceWs As Worksheet) As Date

    If IsDate(sourceWs.Range("B1").Value) Then
        LDR_GetRT624CSProcessingDate = _
            DateValue(sourceWs.Range("B1").Value)
    ElseIf IsDate(sourceWs.Range("B10").Value) Then
        LDR_GetRT624CSProcessingDate = _
            DateValue(sourceWs.Range("B10").Value)
    Else
        LDR_GetRT624CSProcessingDate = Date
    End If
End Function

Private Function LDR_GetPH160BSProcessingDate( _
    ByVal sourceWs As Worksheet) As Date

    If IsDate(sourceWs.Range("C22").Value) Then
        LDR_GetPH160BSProcessingDate = _
            DateValue(sourceWs.Range("C22").Value)
    Else
        LDR_GetPH160BSProcessingDate = Date
    End If
End Function

Private Function LDR_GetPH160ASProcessingDate( _
    ByVal sourceWs As Worksheet) As Date

    If IsDate(sourceWs.Range("C6").Value) Then
        LDR_GetPH160ASProcessingDate = _
            DateValue(sourceWs.Range("C6").Value)
    Else
        LDR_GetPH160ASProcessingDate = Date
    End If
End Function

Private Function LDR_GetInterestSourceColumn( _
    ByVal processingDate As Date, _
    ByRef modeText As String) As String

    Select Case LDR_GetProcessingMode(processingDate, modeText)
        Case LDR_MODE_LONG_WEEKEND
            LDR_GetInterestSourceColumn = "J"

        Case LDR_MODE_MONDAY
            LDR_GetInterestSourceColumn = "I"

        Case Else
            LDR_GetInterestSourceColumn = "X"
    End Select
End Function

Private Function LDR_GetProcessingMode( _
    ByVal processingDate As Date, _
    ByRef modeText As String) As Long

    Dim priorBusinessDate As Date
    Dim calendarDayGap As Long

    priorBusinessDate = LDR_PreviousCanadianBusinessDay(processingDate)
    calendarDayGap = DateDiff( _
        "d", priorBusinessDate, DateValue(processingDate))

    ' Check long weekend first. This covers:
    ' - Tuesday after a Canadian Monday holiday
    ' - Monday after a Canadian Friday holiday
    If calendarDayGap >= 4 Then
        LDR_GetProcessingMode = LDR_MODE_LONG_WEEKEND
        modeText = "LONG WKD"
    ElseIf Weekday(processingDate, vbMonday) = 1 Then
        LDR_GetProcessingMode = LDR_MODE_MONDAY
        modeText = "MONDAY AMT"
    Else
        LDR_GetProcessingMode = LDR_MODE_NORMAL
        modeText = "normal difference"
    End If
End Function

Private Function LDR_PreviousCanadianBusinessDay( _
    ByVal referenceDate As Date) As Date

    Dim resultDate As Date

    resultDate = DateValue(referenceDate) - 1

    Do While Weekday(resultDate, vbMonday) > 5 _
             Or LDR_IsCanadianBankHoliday(resultDate)
        resultDate = resultDate - 1
    Loop

    LDR_PreviousCanadianBusinessDay = resultDate
End Function

Private Function LDR_IsCanadianBankHoliday( _
    ByVal dateToCheck As Date) As Boolean

    Dim calendarDate As Date
    Dim calendarYear As Long
    Dim christmasObserved As Date
    Dim boxingDayObserved As Date

    calendarDate = DateValue(dateToCheck)
    calendarYear = Year(calendarDate)

    ' Bank of Canada / Ontario business-day calendar.
    If calendarDate = LDR_ObservedWeekday( _
        DateSerial(calendarYear, 1, 1)) Then GoTo LDR_HolidayFound

    If calendarDate = LDR_NthWeekdayOfMonth( _
        calendarYear, 2, vbMonday, 3) Then GoTo LDR_HolidayFound

    If calendarDate = LDR_EasterSunday( _
        calendarYear) - 2 Then GoTo LDR_HolidayFound

    If calendarDate = LDR_VictoriaDay( _
        calendarYear) Then GoTo LDR_HolidayFound

    If calendarDate = LDR_ObservedWeekday( _
        DateSerial(calendarYear, 7, 1)) Then GoTo LDR_HolidayFound

    If calendarDate = LDR_NthWeekdayOfMonth( _
        calendarYear, 8, vbMonday, 1) Then GoTo LDR_HolidayFound

    If calendarDate = LDR_NthWeekdayOfMonth( _
        calendarYear, 9, vbMonday, 1) Then GoTo LDR_HolidayFound

    If calendarDate = LDR_ObservedWeekday( _
        DateSerial(calendarYear, 9, 30)) Then GoTo LDR_HolidayFound

    If calendarDate = LDR_NthWeekdayOfMonth( _
        calendarYear, 10, vbMonday, 2) Then GoTo LDR_HolidayFound

    If calendarDate = LDR_ObservedWeekday( _
        DateSerial(calendarYear, 11, 11)) Then GoTo LDR_HolidayFound

    christmasObserved = LDR_ObservedWeekday( _
        DateSerial(calendarYear, 12, 25))

    boxingDayObserved = LDR_ObservedWeekday( _
        DateSerial(calendarYear, 12, 26))

    Do While boxingDayObserved = christmasObserved _
             Or Weekday(boxingDayObserved, vbMonday) > 5
        boxingDayObserved = boxingDayObserved + 1
    Loop

    If calendarDate = christmasObserved Then GoTo LDR_HolidayFound
    If calendarDate = boxingDayObserved Then GoTo LDR_HolidayFound

    Exit Function

LDR_HolidayFound:
    LDR_IsCanadianBankHoliday = True
End Function

Private Function LDR_ObservedWeekday(ByVal holidayDate As Date) As Date
    Select Case Weekday(holidayDate, vbMonday)
        Case 6
            LDR_ObservedWeekday = holidayDate + 2
        Case 7
            LDR_ObservedWeekday = holidayDate + 1
        Case Else
            LDR_ObservedWeekday = holidayDate
    End Select
End Function

Private Function LDR_NthWeekdayOfMonth( _
    ByVal calendarYear As Long, _
    ByVal calendarMonth As Long, _
    ByVal weekdayNumber As VbDayOfWeek, _
    ByVal occurrenceNumber As Long) As Date

    Dim firstDate As Date
    Dim dayOffset As Long

    firstDate = DateSerial(calendarYear, calendarMonth, 1)
    dayOffset = (weekdayNumber - _
                 Weekday(firstDate, vbSunday) + 7) Mod 7

    LDR_NthWeekdayOfMonth = firstDate + _
                            dayOffset + _
                            (7 * (occurrenceNumber - 1))
End Function

Private Function LDR_VictoriaDay(ByVal calendarYear As Long) As Date
    Dim resultDate As Date

    resultDate = DateSerial(calendarYear, 5, 24)

    Do While Weekday(resultDate, vbMonday) <> 1
        resultDate = resultDate - 1
    Loop

    LDR_VictoriaDay = resultDate
End Function

Private Function LDR_EasterSunday(ByVal calendarYear As Long) As Date
    Dim a As Long
    Dim b As Long
    Dim c As Long
    Dim d As Long
    Dim e As Long
    Dim f As Long
    Dim g As Long
    Dim h As Long
    Dim i As Long
    Dim k As Long
    Dim l As Long
    Dim m As Long
    Dim easterMonth As Long
    Dim easterDay As Long

    a = calendarYear Mod 19
    b = calendarYear \ 100
    c = calendarYear Mod 100
    d = b \ 4
    e = b Mod 4
    f = (b + 8) \ 25
    g = (b - f + 1) \ 3
    h = (19 * a + b - d - g + 15) Mod 30
    i = c \ 4
    k = c Mod 4
    l = (32 + 2 * e + 2 * i - h - k) Mod 7
    m = (a + 11 * h + 22 * l) \ 451
    easterMonth = (h + l - 7 * m + 114) \ 31
    easterDay = ((h + l - 7 * m + 114) Mod 31) + 1

    LDR_EasterSunday = DateSerial( _
        calendarYear, easterMonth, easterDay)
End Function

Private Function LDR_FindMatchRow(ByVal ws As Worksheet, _
                                  ByVal headerRow As Long, _
                                  ByVal entityColumn As Long, _
                                  ByVal currencyColumn As Long, _
                                  ByVal annotationColumn As Long, _
                                  ByVal entityId As String, _
                                  ByVal currencyText As String, _
                                  ByVal annotationText As String) As Long
    Dim rowNumber As Long
    Dim finalRow As Long

    finalRow = LDR_LastUsedRow(ws)

    For rowNumber = headerRow + 1 To finalRow
        If LDR_NormalizeText(CStr( _
            ws.Cells(rowNumber, entityColumn).Value2)) = _
            LDR_NormalizeText(entityId) _
           And LDR_NormalizeText(CStr( _
            ws.Cells(rowNumber, currencyColumn).Value2)) = _
            LDR_NormalizeText(currencyText) _
           And LDR_NormalizeText(CStr( _
            ws.Cells(rowNumber, annotationColumn).Value2)) = _
            LDR_NormalizeText(annotationText) Then

            LDR_FindMatchRow = rowNumber
            Exit Function
        End If
    Next rowNumber
End Function

Private Function LDR_FindHeaderRow(ByVal ws As Worksheet) As Long
    Dim rowNumber As Long

    For rowNumber = 1 To 20
        If LDR_FindHeaderColumn(ws, rowNumber, "entityid") > 0 _
           And LDR_FindHeaderColumn(ws, rowNumber, "amount") > 0 _
           And LDR_FindHeaderColumn(ws, rowNumber, "currency") > 0 _
           And LDR_FindHeaderColumn(ws, rowNumber, "annotation") > 0 Then

            LDR_FindHeaderRow = rowNumber
            Exit Function
        End If
    Next rowNumber
End Function

Private Function LDR_FindHeaderColumn(ByVal ws As Worksheet, _
                                      ByVal headerRow As Long, _
                                      ByVal searchToken As String) As Long
    Dim lastColumn As Long
    Dim columnNumber As Long
    Dim normalizedText As String

    lastColumn = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column

    For columnNumber = 1 To lastColumn
        If Not IsError(ws.Cells(headerRow, columnNumber).Value2) Then
            normalizedText = LDR_NormalizeText( _
                CStr(ws.Cells(headerRow, columnNumber).Value2))

            If InStr(1, normalizedText, searchToken, vbTextCompare) > 0 Then
                LDR_FindHeaderColumn = columnNumber
                Exit Function
            End If
        End If
    Next columnNumber
End Function

Private Function LDR_LastUsedRow(ByVal ws As Worksheet) As Long
    Dim finalCell As Range

    Set finalCell = ws.Cells.Find( _
        What:="*", _
        After:=ws.Cells(1, 1), _
        LookIn:=xlFormulas, _
        LookAt:=xlPart, _
        SearchOrder:=xlByRows, _
        SearchDirection:=xlPrevious, _
        MatchCase:=False)

    If finalCell Is Nothing Then
        LDR_LastUsedRow = 1
    Else
        LDR_LastUsedRow = finalCell.Row
    End If
End Function

Private Function LDR_FindOrOpenSourceWorkbook() As Workbook
    Dim wb As Workbook
    Dim candidateWs As Worksheet
    Dim selectedPath As String

    For Each wb In Application.Workbooks
        Set candidateWs = Nothing
        Set candidateWs = LDR_GetWorksheetFlexible(wb, LDR_SOURCE_SHEET)

        If Not candidateWs Is Nothing Then
            Set LDR_FindOrOpenSourceWorkbook = wb
            Exit Function
        End If
    Next wb

    selectedPath = LDR_PickWorkbook( _
        "Select the PB_Summary_NEW workbook")

    If Len(selectedPath) = 0 Then Exit Function

    Set LDR_FindOrOpenSourceWorkbook = Workbooks.Open( _
        Filename:=selectedPath, _
        UpdateLinks:=0, _
        ReadOnly:=True, _
        AddToMru:=False)
End Function

Private Function LDR_FindOrOpenLoaderWorkbook( _
    ByVal sourceWb As Workbook) As Workbook

    Dim wb As Workbook
    Dim candidateWs As Worksheet
    Dim selectedPath As String

    ' First preference: an open workbook whose name contains "PB loader".
    For Each wb In Application.Workbooks
        If Not wb Is sourceWb Then
            If InStr(1, wb.Name, "PB loader", vbTextCompare) > 0 Then
                Set candidateWs = Nothing
                Set candidateWs = LDR_GetWorksheetFlexible( _
                    wb, LDR_TARGET_SHEET)

                If Not candidateWs Is Nothing Then
                    Set LDR_FindOrOpenLoaderWorkbook = wb
                    Exit Function
                End If
            End If
        End If
    Next wb

    ' Second preference: any other open workbook containing TEMPLATE.
    For Each wb In Application.Workbooks
        If Not wb Is sourceWb Then
            Set candidateWs = Nothing
            Set candidateWs = LDR_GetWorksheetFlexible( _
                wb, LDR_TARGET_SHEET)

            If Not candidateWs Is Nothing Then
                Set LDR_FindOrOpenLoaderWorkbook = wb
                Exit Function
            End If
        End If
    Next wb

    selectedPath = LDR_PickWorkbook( _
        "Select the PB loader template workbook")

    If Len(selectedPath) = 0 Then Exit Function

    Set LDR_FindOrOpenLoaderWorkbook = Workbooks.Open( _
        Filename:=selectedPath, _
        UpdateLinks:=0, _
        ReadOnly:=False, _
        AddToMru:=False)
End Function

Private Function LDR_PickWorkbook(ByVal dialogTitle As String) As String
    With Application.FileDialog(3)
        .Title = dialogTitle
        .AllowMultiSelect = False
        .Filters.Clear
        .Filters.Add "Excel workbooks", _
                     "*.xlsx;*.xls;*.xlsm;*.xlsb"

        If .Show = -1 Then LDR_PickWorkbook = .SelectedItems(1)
    End With
End Function

Private Function LDR_GetWorksheetFlexible(ByVal wb As Workbook, _
                                          ByVal expectedName As String) _
                                          As Worksheet
    Dim ws As Worksheet
    Dim normalizedExpected As String

    On Error Resume Next
    Set LDR_GetWorksheetFlexible = wb.Worksheets(expectedName)
    On Error GoTo 0

    If Not LDR_GetWorksheetFlexible Is Nothing Then Exit Function

    normalizedExpected = LDR_NormalizeText(expectedName)

    For Each ws In wb.Worksheets
        If LDR_NormalizeText(ws.Name) = normalizedExpected Then
            Set LDR_GetWorksheetFlexible = ws
            Exit Function
        End If
    Next ws
End Function

Private Function LDR_NormalizeText(ByVal textValue As String) As String
    Dim resultText As String

    resultText = LCase$(Trim$(textValue))
    resultText = Replace(resultText, ChrW(160), "")
    resultText = Replace(resultText, " ", "")
    resultText = Replace(resultText, "_", "")
    resultText = Replace(resultText, "-", "")
    resultText = Replace(resultText, "(", "")
    resultText = Replace(resultText, ")", "")
    resultText = Replace(resultText, "/", "")

    LDR_NormalizeText = resultText
End Function
