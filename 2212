Private Function LDR_GetProcessingMode(ByVal processingDate As Date, _
                                       ByRef modeText As String) As Long

    Dim priorBusinessDate As Date
    Dim calendarDayGap As Long

    priorBusinessDate = LDR_PreviousCanadianBusinessDay(processingDate)
    calendarDayGap = DateDiff("d", priorBusinessDate, DateValue(processingDate))

    ' Check long weekend first. This covers:
    ' - Tuesday after a Canadian Monday holiday
    ' - Monday after a Canadian Friday holiday
    If calendarDayGap >= 4 Then
        LDR_GetProcessingMode = LDR_MODE_LONG_WEEKEND
        modeText = "LONG WKD"
    ElseIf Weekday(processingDate, vbMonday) = 1 Then
        LDR_GetProcessingMode = LDR_MODE_MONDAY
        modeText = "MONDAY AMT"
    Else
        LDR_GetProcessingMode = LDR_MODE_NORMAL
        modeText = "normal difference"
    End If
End Function

' The sheets carry the report date of the previous business day. A sheet
' showing anything else usually means the run is a day late or the wrong file
' is open, which would read the wrong column without any other symptom.
Private Function LDR_CollectDateNotes(ByVal runDate As Date, _
                                      ByVal ph632Rt684Ws As Worksheet, _
                                      ByVal rt624csWs As Worksheet, _
                                      ByVal ph160bsWs As Worksheet, _
                                      ByVal ph160asWs As Worksheet) As String
    Dim expectedDate As Date
    Dim resultText As String

    expectedDate = LDR_PreviousCanadianBusinessDay(runDate)

    LDR_AppendDateNote resultText, ph632Rt684Ws, Array("H1", "H6"), expectedDate
    LDR_AppendDateNote resultText, rt624csWs, Array("B1", "B10"), expectedDate
    LDR_AppendDateNote resultText, ph160bsWs, Array("C22"), expectedDate
    LDR_AppendDateNote resultText, ph160asWs, Array("C6"), expectedDate

    LDR_CollectDateNotes = resultText
End Function

Private Sub LDR_AppendDateNote(ByRef resultText As String, _
                               ByVal ws As Worksheet, _
                               ByVal addresses As Variant, _
                               ByVal expectedDate As Date)
    Dim sheetDate As Date

    If ws Is Nothing Then Exit Sub
    If Not LDR_TryGetSheetDate(ws, addresses, sheetDate) Then Exit Sub
    If sheetDate = expectedDate Then Exit Sub

    resultText = resultText & "- " & ws.Name & " reports " & _
                 Format$(sheetDate, "yyyy-mm-dd") & _
                 ", expected " & Format$(expectedDate, "yyyy-mm-dd") & _
                 "." & vbCrLf
End Sub

Private Function LDR_TryGetSheetDate(ByVal ws As Worksheet, _
                                     ByVal addresses As Variant, _
                                     ByRef resultDate As Date) As Boolean
    Dim addressIndex As Long
    Dim rawValue As Variant

    For addressIndex = LBound(addresses) To UBound(addresses)
        rawValue = ws.Range(CStr(addresses(addressIndex))).Value

        If Not IsError(rawValue) Then
            If IsDate(rawValue) Then
                resultDate = DateValue(rawValue)
                LDR_TryGetSheetDate = True
                Exit Function
            End If
        End If
    Next addressIndex
End Function

Private Function LDR_PreviousCanadianBusinessDay( _
    ByVal referenceDate As Date) As Date

    Dim resultDate As Date

    resultDate = DateValue(referenceDate) - 1

    Do While Weekday(resultDate, vbMonday) > 5 _
             Or LDR_IsCanadianBankHoliday(resultDate)
        resultDate = resultDate - 1
    Loop

    LDR_PreviousCanadianBusinessDay = resultDate
End Function

' Bank of Canada / Ontario business-day calendar.
Private Function LDR_IsCanadianBankHoliday( _
    ByVal dateToCheck As Date) As Boolean

    Dim calendarDate As Date
    Dim calendarYear As Long
    Dim christmasObserved As Date
    Dim boxingDayObserved As Date

    calendarDate = DateValue(dateToCheck)
    calendarYear = Year(calendarDate)

    christmasObserved = LDR_ObservedWeekday(DateSerial(calendarYear, 12, 25))
    boxingDayObserved = LDR_ObservedWeekday(DateSerial(calendarYear, 12, 26))

    Do While boxingDayObserved = christmasObserved _
             Or Weekday(boxingDayObserved, vbMonday) > 5
        boxingDayObserved = boxingDayObserved + 1
    Loop

    If calendarDate = LDR_ObservedWeekday( _
        DateSerial(calendarYear, 1, 1)) Then                        ' New Year
        LDR_IsCanadianBankHoliday = True

    ElseIf calendarDate = LDR_NthWeekdayOfMonth( _
        calendarYear, 2, vbMonday, 3) Then                          ' Family Day
        LDR_IsCanadianBankHoliday = True

    ElseIf calendarDate = LDR_EasterSunday(calendarYear) - 2 Then   ' Good Friday
        LDR_IsCanadianBankHoliday = True

    ElseIf calendarDate = LDR_VictoriaDay(calendarYear) Then        ' Victoria Day
        LDR_IsCanadianBankHoliday = True

    ElseIf calendarDate = LDR_ObservedWeekday( _
        DateSerial(calendarYear, 7, 1)) Then                        ' Canada Day
        LDR_IsCanadianBankHoliday = True

    ElseIf calendarDate = LDR_NthWeekdayOfMonth( _
        calendarYear, 8, vbMonday, 1) Then                          ' Civic Holiday
        LDR_IsCanadianBankHoliday = True

    ElseIf calendarDate = LDR_NthWeekdayOfMonth( _
        calendarYear, 9, vbMonday, 1) Then                          ' Labour Day
        LDR_IsCanadianBankHoliday = True

    ElseIf LDR_OBSERVE_SEPT30 And calendarDate = LDR_ObservedWeekday( _
        DateSerial(calendarYear, 9, 30)) Then                       ' Truth and Reconciliation
        LDR_IsCanadianBankHoliday = True

    ElseIf calendarDate = LDR_NthWeekdayOfMonth( _
        calendarYear, 10, vbMonday, 2) Then                         ' Thanksgiving
        LDR_IsCanadianBankHoliday = True

    ElseIf LDR_OBSERVE_NOV11 And calendarDate = LDR_ObservedWeekday( _
        DateSerial(calendarYear, 11, 11)) Then                      ' Remembrance Day
        LDR_IsCanadianBankHoliday = True

    ElseIf calendarDate = christmasObserved Then                    ' Christmas
        LDR_IsCanadianBankHoliday = True

    ElseIf calendarDate = boxingDayObserved Then                    ' Boxing Day
        LDR_IsCanadianBankHoliday = True
    End If
End Function

Private Function LDR_ObservedWeekday(ByVal holidayDate As Date) As Date
    Select Case Weekday(holidayDate, vbMonday)
        Case 6
            LDR_ObservedWeekday = holidayDate + 2
        Case 7
            LDR_ObservedWeekday = holidayDate + 1
        Case Else
            LDR_ObservedWeekday = holidayDate
    End Select
End Function

Private Function LDR_NthWeekdayOfMonth( _
    ByVal calendarYear As Long, _
    ByVal calendarMonth As Long, _
    ByVal weekdayNumber As VbDayOfWeek, _
    ByVal occurrenceNumber As Long) As Date

    Dim firstDate As Date
    Dim dayOffset As Long

    firstDate = DateSerial(calendarYear, calendarMonth, 1)
    dayOffset = (weekdayNumber - Weekday(firstDate, vbSunday) + 7) Mod 7

    LDR_NthWeekdayOfMonth = firstDate + dayOffset + (7 * (occurrenceNumber - 1))
End Function

Private Function LDR_VictoriaDay(ByVal calendarYear As Long) As Date
    Dim resultDate As Date

    resultDate = DateSerial(calendarYear, 5, 24)

    Do While Weekday(resultDate, vbMonday) <> 1
        resultDate = resultDate - 1
    Loop

    LDR_VictoriaDay = resultDate
End Function

Private Function LDR_EasterSunday(ByVal calendarYear As Long) As Date
    Dim a As Long
    Dim b As Long
    Dim c As Long
    Dim d As Long
    Dim e As Long
    Dim f As Long
    Dim g As Long
    Dim h As Long
    Dim i As Long
    Dim k As Long
    Dim l As Long
    Dim m As Long
    Dim easterMonth As Long
    Dim easterDay As Long

    a = calendarYear Mod 19
    b = calendarYear \ 100
    c = calendarYear Mod 100
    d = b \ 4
    e = b Mod 4
    f = (b + 8) \ 25
    g = (b - f + 1) \ 3
    h = (19 * a + b - d - g + 15) Mod 30
    i = c \ 4
    k = c Mod 4
    l = (32 + 2 * e + 2 * i - h - k) Mod 7
    m = (a + 11 * h + 22 * l) \ 451
    easterMonth = (h + l - 7 * m + 114) \ 31
    easterDay = ((h + l - 7 * m + 114) Mod 31) + 1

    LDR_EasterSunday = DateSerial(calendarYear, easterMonth, easterDay)
End Function

